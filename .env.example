# AnchorPoint local Docker Compose configuration

POSTGRES_USER=anchorpoint
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=anchorpoint

# Redis requires authentication; docker-compose refuses to start without it.
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Alertmanager routing (used by the monitoring profile). PAGERDUTY_ROUTING_KEY
# is required for PagerDuty receivers; SLACK_WEBHOOK_URL routes ops alerts
# (e.g. DatabaseConnectionExhausted) to the #ops-alerts Slack channel.
PAGERDUTY_ROUTING_KEY=
SLACK_WEBHOOK_URL=
