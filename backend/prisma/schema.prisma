// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  Free
  Pro
  Enterprise
}

model User {
  id                        String                    @id @default(uuid())
  publicKey                 String                    @unique
  email                     String?
  phone                     String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  transactions              Transaction[]
  kycCustomer               KycCustomer?
  apiKeys                   ApiKey[]
  recurringPaymentSchedules RecurringPaymentSchedule[]
  notificationPreference    NotificationPreference?

  @@index([publicKey])
}

model AdminUser {
  id                  String                    @id @default(uuid())
  email               String                    @unique
  passwordHash        String
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  passwordResetTokens AdminPasswordResetToken[]

  @@index([email])
}

model AdminPasswordResetToken {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId, usedAt])
  @@index([expiresAt])
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tier      Tier     @default(Free)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([key])
  @@index([userId])
}

enum RecurringPaymentScheduleStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum RecurringPaymentRunStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model RecurringPaymentSchedule {
  id          String                         @id @default(uuid())
  userId      String
  user        User                           @relation(fields: [userId], references: [id])
  destination String
  assetCode   String
  amount      String
  cron        String
  status      RecurringPaymentScheduleStatus @default(ACTIVE)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  // Number of consecutive failed executions for the current occurrence.
  // Reset to 0 after a successful run or after retries are exhausted.
  retryCount  Int                            @default(0)
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  runs        RecurringPaymentRun[]

  @@index([userId])
  @@index([status, nextRunAt])
}

model RecurringPaymentRun {
  id          String                    @id @default(uuid())
  scheduleId  String
  schedule    RecurringPaymentSchedule  @relation(fields: [scheduleId], references: [id])
  status      RecurringPaymentRunStatus @default(PENDING)
  attempt     Int                       @default(0)
  stellarTxId String?                   @unique
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([scheduleId])
  @@index([status])
}

model Transaction {
  id                  String         @id @default(uuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id])
  assetCode           String
  amount              String
  type                String         // DEPOSIT | WITHDRAW | SEP31 | SWAP
  status              String         // PENDING, COMPLETED, FAILED
  externalId          String?        @unique
  stellarTxId         String?        @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  notifications       Notification[]

  // Fee tracking
  feeAmount           String?        @default("0")
  feeAssetCode        String?
  feeType             String?

  // SEP-31 specific fields
  senderInfo          Json?
  receiverInfo        Json?
  callbackUrl         String?
  sep31Status         String?
  requiredInfoMessage String?
  completedAt         DateTime?
  refunded            Boolean        @default(false)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model FeeReport {
  id              String   @id @default(uuid())
  reportType      String
  startDate       DateTime
  endDate         DateTime
  totalFees       String
  totalFeesXLM    String
  operationCounts Json
  feeBreakdown    Json
  generatedAt     DateTime @default(now())
  filePath        String?
  fileType        String?

  @@index([reportType])
  @@index([startDate])
  @@index([endDate])
}



model NotificationPreference {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)
  pushEnabled  Boolean @default(false)

  @@index([userId])
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id            String             @id @default(uuid())
  userId        String
  transactionId String?
  transaction   Transaction?       @relation(fields: [transactionId], references: [id])
  type          NotificationType
  status        NotificationStatus @default(PENDING)
  message       String
  createdAt     DateTime           @default(now())

  @@index([userId])
  @@index([transactionId])
}

enum KYCStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model KycCustomer {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  provider    String?
  providerRef String?
  firstName   String?
  lastName    String?
  email       String?
  status      KYCStatus @default(PENDING)
  extraFields Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([provider, providerRef])
  @@index([userId])
  @@index([status])
}

model Quote {
  id            String   @id @default(uuid())
  sellAsset     String
  sellAmount    String
  buyAsset      String
  buyAmount     String
  price         String
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sellAsset])
  @@index([buyAsset])
}

model SystemConfig {
  id        String   @id @default(uuid())
  version   Int      @unique
  settings  String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isActive])
  @@index([createdAt])
}

// Immutable audit trail for privileged system configuration changes.
// Every create/update/rollback of the dynamic SystemConfig produces one row
// capturing who made the change, from where, and what changed.
model AdminConfigAuditLog {
  id              String   @id @default(uuid())
  action          String // CONFIG_UPDATE | CONFIG_UI_UPDATE | CONFIG_ROLLBACK
  actorId         String? // Admin user id, when known
  actorEmail      String? // Admin email / api-key label, when known
  actorIp         String?
  userAgent       String?
  configVersion   Int? // Resulting config version after the change
  previousVersion Int? // Config version prior to the change
  changedKeys     String? // JSON array of changed top-level config keys
  diff            String? // JSON object: { key: { before, after } }
  metadata        String? // JSON object with any extra context
  createdAt       DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([configVersion])
  @@index([createdAt])
}

enum JobStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
  RETRYING
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ContractJob {
  id              String      @id @default(uuid())
  jobId           String      @unique
  type            String
  priority        JobPriority @default(NORMAL)
  status          JobStatus   @default(PENDING)
  contractId      String?
  functionName    String?
  parameters      Json?
  result          Json?
  error           String?
  errorCategory   String?
  errorSeverity   String?
  errorCode       String?
  userMessage     String?
  suggestedAction String?
  retryable       Boolean     @default(false)
  attempts        Int         @default(0)
  maxAttempts     Int         @default(3)
  createdBy       String?
  metadata        Json?
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([createdBy])
  @@index([type])
}

model ContractEvent {
  id              String   @id @default(uuid())
  contractId      String
  ledger          Int
  ledgerClosedAt  DateTime
  txHash          String
  contractEventId String   @unique // The unique ID from Soroban RPC
  topics          String   // JSON stringified topics
  value           String   // JSON stringified value
  type            String   // e.g., "contract"
  createdAt       DateTime @default(now())

  @@index([contractId])
  @@index([txHash])
  @@index([ledger])
}

enum MultisigStatus {
  PENDING
  PARTIALLY_SIGNED
  READY
  SUBMITTED
  FAILED
  EXPIRED
}

model MultisigTransaction {
  id                String              @id @default(uuid())
  envelopeXdr       String
  hash              String              @unique
  creatorPublicKey  String
  requiredSigners   Json
  threshold         Int
  currentSignatures Int                 @default(0)
  status            MultisigStatus      @default(PENDING)
  memo              String?
  expiresAt         DateTime?
  submittedAt       DateTime?
  stellarTxId       String?             @unique
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  signatures        MultisigSignature[]
  notifications     MultisigNotification[]
}

model MultisigSignature {
  id                    String              @id @default(uuid())
  multisigTransactionId String
  multisigTransaction   MultisigTransaction @relation(fields: [multisigTransactionId], references: [id], onDelete: Cascade)
  signerPublicKey       String
  signature             String
  createdAt             DateTime            @default(now())

  @@unique([multisigTransactionId, signerPublicKey])
}

model MultisigNotification {
  id                    String              @id @default(uuid())
  multisigTransactionId String
  multisigTransaction   MultisigTransaction @relation(fields: [multisigTransactionId], references: [id], onDelete: Cascade)
  recipientPublicKey    String
  type                  String
  message               String
  readAt                DateTime?
  sentAt                DateTime            @default(now())
  createdAt             DateTime            @default(now())

  @@index([recipientPublicKey, readAt])
}

model AssetValidationResult {
  assetCode        String
  issuerPublicKey  String
  homeDomain       String?
  complianceStatus String
  messages         String
  rawToml          String?
  lastCrawledAt    DateTime

  @@id([assetCode, issuerPublicKey])
  @@unique([assetCode, issuerPublicKey], name: "assetCode_issuerPublicKey")
}

model CrawlJobRecord {
  id                String    @id @default(uuid())
  startedAt         DateTime
  completedAt       DateTime?
  totalAssets       Int
  compliantCount    Int
  nonCompliantCount Int
  suspiciousCount   Int
}

model UploadRecord {
  id          String   @id @default(uuid())
  key         String   @unique
  contentType String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}
