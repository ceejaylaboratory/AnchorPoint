      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (endpoint) (rate(stellar_horizon_rpc_requests_total[5m]))",
          "legendFormat": "{{endpoint}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "RPC Request Rate (QPS by Endpoint)",
      "type": "timeseries"
